{
  "name": "climbing-world-traveler",
  "private": true,
  "version": "0.1.0",
  "description": "A climbing career RPG: build a climber, live a climbing life.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "validate": "tsx scripts/validate.ts",
    "calibrate": "tsx scripts/calibrate.ts",
    "harness": "tsx scripts/harness.ts",
    "recost": "tsx scripts/recost.ts",
    "benchmarks": "tsx scripts/build-benchmarks.ts"
  },
  "dependencies": {
    "@preact/signals": "^2.0.0",
    "idb": "^8.0.0",
    "preact": "^10.26.0",
    "workbox-window": "^7.4.1",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.0",
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vite-plugin-pwa": "^1.0.0",
    "vitest": "^3.0.0"
  },
  "packageManager": "pnpm@10.28.0"
}
